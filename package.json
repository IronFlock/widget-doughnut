{
    "name": "@ironflock/widget-doughnut",
    "description": "REWidget widget-doughnut",
    "license": "MIT",
    "author": "widget-doughnut",
    "version": "1.5.32",
    "engines": {
        "node": ">=24.9.0",
        "npm": ">=10.0.2"
    },
    "type": "module",
    "main": "dist/widget-doughnut.js",
    "types": "dist/src/widget-doughnut.d.ts",
    "files": [
        "dist",
        "src",
        "thumbnail.png",
        "thumbnail.webp"
    ],
    "scripts": {
        "start": "vite build --watch & vite",
        "build": "vite build",
        "watch": "vite build --watch",
        "link": "npm run build && npm link && cd ../../studio && npm link @ironflock/widget-doughnut",
        "unlink": "npm unlink --global && cd ../../studio && npm unlink @ironflock/widget-doughnut && npm i @ironflock/widget-doughnut",
        "types": "cat src/definition-schema.json | json2ts --style.tabWidth=4 > src/definition-schema.d.ts",
        "preversion": "sh scripts/release-preflight.sh",
        "version": "npm run build",
        "postversion": "git push --follow-tags && sh scripts/release-verify.sh",
        "release": "npm version patch",
        "release:minor": "npm version minor",
        "release:major": "npm version major"
    },
    "dependencies": {
        "lit": "^3.3.3",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "echarts": "^6.0.0"
    },
    "devDependencies": {
        "@rollup/plugin-replace": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "eslint": "^9.36.0",
        "eslint-config-prettier": "^10.1.5",
        "husky": "^9.1.7",
        "json-schema-to-typescript": "^15.0.4",
        "lint-staged": "^16.2.3",
        "prettier": "^3.6.2",
        "rimraf": "^6.0.1",
        "typescript": "5.9.3",
        "vite": "^7.3.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/IronFlock/widget-doughnut.git"
    },
    "keywords": [
        "widget",
        "doughnut"
    ],
    "bugs": {
        "url": "https://github.com/IronFlock/widget-doughnut/issues"
    },
    "homepage": "https://github.com/IronFlock/widget-doughnut#readme"
}
